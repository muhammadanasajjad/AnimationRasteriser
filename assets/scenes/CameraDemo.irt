scene CameraDemo {
    camera cam {
        position: (0, 0, -5)
        lookAt: (0, 0, 0)
        zoom: 1.0
    }

    square b {
        size: 2
        fill: (0.9, 0.2, 0.2, 1)
        position: (-3, 3)
    }

    square b2 {
        size: 1.5
        fill: (0.2, 0.5, 0.9, 1)
        position: (3, 4)
    }

    path flight {
        (-4, -6, -5), (0, 0, -9), (4, 6, -5)
    }

    timeline {
        move b to (3, -4) over 3s
        move b2 to (-3, -4) over 3s
        move camera to flight over 6s
        look camera at (0, 0, 0) over 6s
    }
}

play CameraDemo
