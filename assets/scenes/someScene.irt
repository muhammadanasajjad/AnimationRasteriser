scene someScene {
    axes ax {
        x: (-8, 8)
        y: (-4, 4)
    }

    square box {
        size: 2.5
        position: (-6, -2)
        fill: (0.9, 0.35, 0.2, 1)
        opacity: 0
        layer: 1
    }

    graph quadratic on ax {
        y = x^2 / 8 - 2
        colour: (0.25, 0.65, 1, 1)
        strokeWeight: 0.12
    }

    graph cubic on ax {
        y = x^3 / 40 + x / 4
        colour: (0.2, 0.85, 0.45, 1)
        strokeWeight: 0.12
    }

    timeline {
        serial {
            draw quadratic over 1200ms easing easeInOutSine
            fade box in over 600ms easing quadOut
            rotate box to (0, 360, 0) over 1500ms easing linear
            draw cubic over 1200ms easing easeInOutSine
        }
    }
}

play someScene
