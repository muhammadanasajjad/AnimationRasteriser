scene PathOriented {
    camera cam {
        position: (0, 0, -7)
        lookAt: (0, 0, 0)
        zoom: 1.0
    }

    square plain {
        size: 1.6
        fill: (0.9, 0.2, 0.2, 1)
        position: (-6, 0)
    }

    square oriented {
        size: 1.6
        fill: (0.2, 0.6, 0.25, 1)
        position: (-6, 0)
    }

    path slalom {
        (-6, 0, -2), (-2, 2, 2), (0, 0, -2), (2, -2, 2), (6, 0, -1)
    }

    path camOrbit {
        (0, -5, -7), (0, 0, -10), (0, 5, -7)
    }

    timeline {
        move plain to slalom over 5s easing linear
        move oriented to slalom oriented over 5s easing linear
        move camera to camOrbit over 5s
        look camera at (0, 0, 0) over 5s
    }
}

play PathOriented
